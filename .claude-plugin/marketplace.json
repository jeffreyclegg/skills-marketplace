{
  "$schema": "https://anthropic.com/claude-code/marketplace.schema.json",
  "name": "jeffreyclegg",
  "description": "Vendored, pinned and remixed agent skills. Built from sources.toml.",
  "owner": {
    "name": "Jeff Clegg",
    "url": "https://github.com/jeffreyclegg"
  },
  "plugins": [
    {
      "name": "anthropic",
      "displayName": "Anthropic Skills",
      "description": "[vendor] docx, pdf, pptx, xlsx, skill-creator, theme-factory, summarize-meeting, doc-coauthoring",
      "author": {
        "name": "Anthropic",
        "url": "https://github.com/anthropics"
      },
      "source": "./plugins/anthropic",
      "category": "vendor",
      "keywords": [
        "vendor",
        "vendored"
      ],
      "repository": "https://github.com/anthropics/skills"
    },
    {
      "name": "azure",
      "displayName": "Azure Skills",
      "description": "[vendor] Azure skills from Microsoft: AKS, App Service, Foundry, storage, cost, compliance, diagnostics",
      "author": {
        "name": "Microsoft",
        "url": "https://github.com/microsoft"
      },
      "source": "./plugins/azure",
      "category": "vendor",
      "keywords": [
        "vendor",
        "vendored"
      ],
      "repository": "https://github.com/microsoft/azure-skills"
    },
    {
      "name": "mattpocock",
      "displayName": "Matt Pocock Skills",
      "description": "[community] wayfinder + dependency closure; grilling, domain-modeling, research, prototype, codebase-design",
      "author": {
        "name": "Matt Pocock",
        "url": "https://github.com/mattpocock"
      },
      "source": "./plugins/mattpocock",
      "category": "community",
      "keywords": [
        "community",
        "vendored"
      ],
      "repository": "https://github.com/mattpocock/skills"
    },
    {
      "name": "mitsuhiko",
      "displayName": "Agent Stuff",
      "description": "[community] openscad and other agent utilities from Armin Ronacher",
      "author": {
        "name": "Armin Ronacher",
        "url": "https://github.com/mitsuhiko"
      },
      "source": "./plugins/mitsuhiko",
      "category": "community",
      "keywords": [
        "community",
        "vendored"
      ],
      "repository": "https://github.com/mitsuhiko/agent-stuff"
    },
    {
      "name": "ponytail",
      "displayName": "Ponytail",
      "description": "[community] Lazy-senior-dev mode: minimal, stdlib-first solutions, with review/audit/debt commands",
      "author": {
        "name": "Dietrich Gebert",
        "url": "https://github.com/DietrichGebert"
      },
      "source": "./plugins/ponytail",
      "category": "community",
      "keywords": [
        "community",
        "vendored"
      ],
      "repository": "https://github.com/DietrichGebert/ponytail"
    }
  ]
